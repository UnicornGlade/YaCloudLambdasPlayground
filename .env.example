# ONLY for local development. Never use these credentials in Yandex Cloud.
DATABASE_URL=postgresql://counter:counter@127.0.0.1:54329/counter
PGSSLMODE=disable

# Cloud connections must use PGSSLMODE=verify-full and the Yandex CA file:
# PGSSLROOTCERT=/absolute/path/to/CA.pem

# Optional direct HTTPS link to a public test archive in the large-files bucket.
# This value is public and is embedded in the static build. Rebuild when changed.
NUXT_PUBLIC_DOWNLOAD_URL=
